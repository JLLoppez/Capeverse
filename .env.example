# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cape_compass?schema=public"

# ─── Admin Auth ───────────────────────────────────────────────────────────────
# Do NOT set ADMIN_EMAIL/ADMIN_PASSWORD here — use the /api/admin/setup endpoint
# on first deploy instead. Only set ADMIN_SESSION_SECRET.
ADMIN_SESSION_SECRET="change-me-with-a-long-random-secret-min-32-chars"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""

# ─── Email (Resend / SMTP) ────────────────────────────────────────────────────
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="resend"
SMTP_PASS=""
FROM_EMAIL="Capiverse <noreply@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL="ops@yourdomain.com"

# ─── Stripe (Payments) ────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Cloudinary (Image Uploads) ───────────────────────────────────────────────
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Sentry (Error Monitoring) ────────────────────────────────────────────────
# Get DSN from https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=""
