# ─────────────────────────────────────────────────────────────────────────────
# Capiverse — Environment Variables
# Copy to .env and fill in. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/capiverse?sslmode=require"

# Min 32 random chars — generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ── Admin credentials (bootstrap before running /api/admin/setup) ─────────────
# These are the fallback credentials used on first login.
# After calling POST /api/admin/setup, those DB-hashed credentials take over
# and these env vars are superseded (but kept as fallback if DB is unreachable).
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="change-me-min-12-chars"

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your key: https://aistudio.google.com/app/apikey
# Free tier covers development + moderate production traffic.
# AI features (itinerary enrichment, chat, weather narrative) degrade gracefully without this.
GEMINI_API_KEY="AIza..."

# ── ATMOS Weather ─────────────────────────────────────────────────────────────
# Free tier: 1,000 calls/day — https://openweathermap.org/api
# WeatherWidget + weather-aware itineraries are disabled without this.
OWM_API_KEY="your-owm-api-key"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Works with Resend (recommended), SendGrid, Mailgun, or any SMTP server.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="resend"
SMTP_PASS="re_..."
FROM_EMAIL="Cape Compass <hello@capiverse.co.za>"
ADMIN_NOTIFICATION_EMAIL="team@capiverse.co.za"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://capiverse.co.za"
NEXT_PUBLIC_ACTIVE_DESTINATION="cape-town"

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# International format, no + or spaces: e.g. 27821234567
NEXT_PUBLIC_WHATSAPP_NUMBER="27821234567"

# ── Cron (protects /api/cron/* routes) ────────────────────────────────────────
# Generate with: openssl rand -hex 24
CRON_SECRET="your-cron-secret"

# ── Sentry ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://xxx@oyyy.ingest.sentry.io/zzz"

# ── Cloudinary (image uploads in admin) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="your-key"
CLOUDINARY_API_SECRET="your-secret"
