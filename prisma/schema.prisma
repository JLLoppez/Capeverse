generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tour {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  summary      String
  description  String
  durationType String
  priceFrom    Decimal
  category     String
  isPrivate    Boolean    @default(true)
  isFeatured   Boolean    @default(false)
  isActive     Boolean    @default(true)
  highlights   Json
  imageUrl     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  stops        TourStop[]
  bookings     Booking[]
  reviews      Review[]
}

model Attraction {
  id                    String     @id @default(cuid())
  name                  String
  slug                  String     @unique
  region                String
  shortDescription      String
  fullDescription       String
  estimatedVisitMinutes Int
  entranceFee           Decimal?
  latitude              Float?
  longitude             Float?
  tags                  Json
  imageUrl              String?
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  tourStops             TourStop[]
}

model TourStop {
  id                   String     @id @default(cuid())
  tourId               String
  attractionId         String
  stopOrder            Int
  suggestedStopMinutes Int?
  attraction           Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  tour                 Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, attractionId])
}

model Enquiry {
  id                String    @id @default(cuid())
  fullName          String
  email             String
  phone             String?
  nationality       String?
  travelDate        DateTime?
  groupSize         Int?
  budgetRange       String?
  message           String?
  source            String    @default("website")
  status            String    @default("New")
  tripLengthDays    Int?
  travelStyle       String?
  pace              String?
  interests         Json?
  mustSee           Json?
  accommodationArea String?
  aiSummary         String?
  itineraryJson     Json?
  itineraryToken    String?   // links back to a SavedItinerary
  consultantNotes   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AdminSetup {
  id           String   @id
  email        String   @unique
  passwordHash String
  completedAt  DateTime
  createdAt    DateTime @default(now())
}

model Booking {
  id              String    @id @default(cuid())
  tourId          String
  stripeSessionId String    @unique
  customerName    String
  customerEmail   String
  travelDate      DateTime?
  groupSize       Int
  amountZar       Int
  status          String    @default("Confirmed")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tour            Tour      @relation(fields: [tourId], references: [id])
  reviewRequested Boolean   @default(false)
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

// ── New: saved itinerary with share token ────────────────────────────────────
model SavedItinerary {
  id             String   @id @default(cuid())
  token          String   @unique @default(cuid())
  itineraryJson  Json     // full result from /api/itinerary/generate
  inputJson      Json     // the original PlannerInput so it can be re-run
  days           Int
  budget         String
  pace           String
  groupType      String
  interests      Json     // string[]
  createdAt      DateTime @default(now())
  expiresAt      DateTime // 90 days from creation

  @@index([token])
  @@index([createdAt])
}

// ── New: post-booking review ─────────────────────────────────────────────────
model Review {
  id          String   @id @default(cuid())
  tourId      String
  bookingId   String?  // optional — link back to the booking
  reviewToken String   @unique @default(cuid()) // emailed to customer
  rating      Int?     // 1-5, null until submitted
  body        String?
  authorName  String?
  approved    Boolean  @default(false)
  submittedAt DateTime?
  createdAt   DateTime @default(now())
  tour        Tour     @relation(fields: [tourId], references: [id])

  @@index([tourId])
  @@index([reviewToken])
}

// ── New: funnel event tracking ───────────────────────────────────────────────
model FunnelEvent {
  id        String   @id @default(cuid())
  event     String   // viewed_tour | started_planner | generated_itinerary | saved_itinerary | submitted_enquiry | completed_booking
  sessionId String?
  tourId    String?
  path      String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([sessionId])
  @@index([createdAt])
}

// ── Operator availability: blocked dates and capacity limits ─────────────────
model OperatorAvailability {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  maxGroups Int      @default(0)  // 0 = fully blocked
  note      String?
  createdAt DateTime @default(now())

  @@unique([date])
  @@index([date])
}
