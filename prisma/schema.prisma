generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tour {
  id               String             @id @default(cuid())
  title            String
  slug             String             @unique
  summary          String
  description      String
  durationType     String
  priceFrom        Decimal
  category         String
  isPrivate        Boolean            @default(true)
  isFeatured       Boolean            @default(false)
  isActive         Boolean            @default(true)
  highlights       Json
  imageUrl         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bookings         Booking[]
  TourAvailability TourAvailability[]
  stops            TourStop[]
  reviews          Review[]
}

model Attraction {
  id                    String     @id @default(cuid())
  name                  String
  slug                  String     @unique
  region                String
  shortDescription      String
  fullDescription       String
  estimatedVisitMinutes Int
  entranceFee           Decimal?
  latitude              Float?
  longitude             Float?
  tags                  Json
  imageUrl              String?
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  tourStops             TourStop[]
}

model TourStop {
  id                   String     @id @default(cuid())
  tourId               String
  attractionId         String
  stopOrder            Int
  suggestedStopMinutes Int?
  attraction           Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  tour                 Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, attractionId])
}

model Enquiry {
  id                   String    @id @default(cuid())
  fullName             String
  email                String
  phone                String?
  nationality          String?
  travelDate           DateTime?
  groupSize            Int?
  budgetRange          String?
  message              String?
  source               String    @default("website")
  status               String    @default("New")
  tripLengthDays       Int?
  travelStyle          String?
  pace                 String?
  interests            Json?
  mustSee              Json?
  accommodationArea    String?
  aiSummary            String?
  itineraryJson        Json?
  consultantNotes      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  aiChatSummary        String?
  convertedToBookingId String?
  followUpDate         DateTime?
  followUpNote         String?
}

model AdminSetup {
  id           String   @id
  email        String   @unique
  passwordHash String
  completedAt  DateTime
  createdAt    DateTime @default(now())
}

// Fix 1+2: Added reviewRequested field and Review relation
model Booking {
  id              String    @id @default(cuid())
  tourId          String
  stripeSessionId String    @unique
  customerName    String
  customerEmail   String
  travelDate      DateTime?
  groupSize       Int
  amountZar       Int
  status          String    @default("Confirmed")
  reviewRequested Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tour            Tour      @relation(fields: [tourId], references: [id])
  review          Review?
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model TourAvailability {
  id          String   @id
  tourId      String
  blockedDate DateTime @db.Date
  reason      String?
  maxCapacity Int?
  createdAt   DateTime @default(now())
  Tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, blockedDate])
  @@index([blockedDate])
  @@index([tourId])
}

// Fix 1: Added OperatorAvailability model used by availability routes
model OperatorAvailability {
  id         String   @id @default(cuid())
  date       DateTime @unique @db.Date
  maxGroups  Int      @default(0)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}

// Fix 2: Added bookingId relation; rating/body/authorName nullable for pending reviews
model Review {
  id          String    @id @default(cuid())
  token       String    @unique
  rating      Int?
  body        String?
  authorName  String?
  approved    Boolean   @default(false)
  submittedAt DateTime?

  tourId      String
  tour        Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)

  bookingId   String?   @unique
  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())

  @@index([tourId])
}

model FunnelEvent {
  id        String   @id @default(cuid())
  event     String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

model SavedItinerary {
  id            String   @id @default(cuid())
  token         String   @unique
  itineraryJson Json
  inputJson     Json?
  days          Int
  budget        String?
  pace          String?
  groupType     String?
  interests     Json?
  createdAt     DateTime @default(now())
  expiresAt     DateTime
}
